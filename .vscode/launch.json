{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OTPClip: No args",
            "type": "python",
            "request": "launch",
            "module": "poetry",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "run",
                "otpclip",
              ],
            "justMyCode": true
        },
        {
            "name": "Run tests",
            "type": "python",
            "request": "launch",
            "module": "poetry",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "run",
                "pytest",
                "--trace",
                "--maxfail=1",
                "--disable-warnings"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}